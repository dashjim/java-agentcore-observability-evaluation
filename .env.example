# 运维人员从 AWS 默认凭证链提供短期凭证；本文件不保存 Access Key 或 Secret。
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# 运维人员必须把这些值改成 setup_evaluation.py 输出的 service 和日志组。
OTEL_SERVICE_NAME=customer-java-agent
OTEL_RESOURCE_ATTRIBUTES=service.name=customer-java-agent,aws.service.type=gen_ai_agent,aws.log.group.names=/aws/bedrock-agentcore/runtimes/customer-java-agent
OTEL_EXPORTER_OTLP_TRACES_HEADERS=x-aws-log-group=/aws/bedrock-agentcore/runtimes/customer-java-agent,x-aws-log-stream=spans

# 应用通过 ADOT Java agent 导出 traces；目录按实际机器填写。
JAVA_BUILD_DIR=./.local/java-build
ADOT_JAVA_AGENT_JAR=./.local/aws-opentelemetry-agent.jar

# 演示需要对话与工具内容才能完成质量评估；只使用本地演示数据运行示例。
CAPTURE_CONTENT=true
MAX_MODEL_CALLS=5

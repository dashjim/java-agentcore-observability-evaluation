    {
      "type": "log",
      "x": 0,
      "y": 22,
      "width": 24,
      "height": 6,
      "properties": {
        "title": "CloudWatch 日志统计 · 各 evaluator 评分条数 / 均值 / 错误数",
        "query": "SOURCE '/aws/bedrock-agentcore/evaluations/results/example_config-0000000000'\n| fields jsonParse(@message) as r\n| filter r.name = \"gen_ai.evaluation.result\"\n| filter coalesce(r.`service.name`, r.resource.attributes.`service.name`) = \"example-java-agent\"\n| filter (r.onlineEvaluationConfigId = \"example_config-0000000000\" or r.attributes.`aws.bedrock_agentcore.online_evaluation_config.arn` = \"arn:aws:bedrock-agentcore:us-east-1:000000000000:online-evaluation-config/example_config-0000000000\")\n| fields r.attributes.`gen_ai.evaluation.name` as evaluator, r.attributes.`gen_ai.evaluation.score.value` as score, coalesce(r.attributes.error, 0) as evaluation_error\n| stats count(*) as result_events, count(score) as score_samples, avg(score) as average_score, sum(evaluation_error) as evaluation_errors by evaluator",
        "view": "table",
        "region": "us-east-1"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 28,
      "width": 24,
      "height": 8,
      "properties": {
        "title": "CloudWatch 最近评分与错误 · 会话 / Trace / evaluator / 分值 / 解释",
        "query": "SOURCE '/aws/bedrock-agentcore/evaluations/results/example_config-0000000000'\n| fields jsonParse(@message) as r\n| filter r.name = \"gen_ai.evaluation.result\"\n| filter coalesce(r.`service.name`, r.resource.attributes.`service.name`) = \"example-java-agent\"\n| filter (r.onlineEvaluationConfigId = \"example_config-0000000000\" or r.attributes.`aws.bedrock_agentcore.online_evaluation_config.arn` = \"arn:aws:bedrock-agentcore:us-east-1:000000000000:online-evaluation-config/example_config-0000000000\")\n| fields @timestamp, r.attributes.`session.id` as session, r.traceId as trace, r.attributes.`gen_ai.evaluation.name` as evaluator, r.attributes.`gen_ai.evaluation.score.value` as value, r.attributes.`gen_ai.evaluation.explanation` as explanation, r.attributes.error as evaluation_error, r.attributes.`error.type` as error_type, r.attributes.`error.message` as error_message\n| sort @timestamp desc\n| limit 30",
        "view": "table",
        "region": "us-east-1"
      }
    }
